# Maintainer: FelippeTN <felippenalim2004 at gmail dot com>
pkgname=gamedoro
pkgver=0.1.0
pkgrel=1
pkgdesc="Pomodoro ultraleve para Waybar com as trilhas de Minecraft, The Witcher 3 e The Last of Us"
arch=('x86_64' 'aarch64')
url="https://github.com/FelippeTN/Gamedoro-Pomodoro-for-Archlinux"
license=('MIT')
depends=('gcc-libs' 'glibc' 'alsa-lib' 'pipewire' 'libnotify' 'yt-dlp' 'ffmpeg' 'waybar')
makedepends=('cargo')
optdepends=(
  'rofi: menu de controle do clique direito'
  'xdg-utils: abrir a pasta das músicas pelo menu'
  'pipewire-alsa: saída de áudio pelo PipeWire'
  'ttf-jetbrains-mono-nerd: ícones e alinhamento do tooltip'
)
options=('!debug') # o Cargo já faz strip (profile.release)
install=gamedoro.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6f86f236b0902de566a2c1a228dfa84dff0f8599fb8c2edf6e888c840ac7f7c6')

_srcdir="Gamedoro-Pomodoro-for-Archlinux-$pkgver"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/gamedoro "$pkgdir/usr/bin/gamedoro"
  install -Dm644 -t "$pkgdir/usr/share/gamedoro/" waybar/custom-gamedoro.jsonc waybar/gamedoro.rasi waybar/gamedoro.css
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
